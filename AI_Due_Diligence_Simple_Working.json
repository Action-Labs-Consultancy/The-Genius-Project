{
  "name": "AI Due Diligence - Simple Working Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Minute",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/jsonrpc.php",
        "requestMethod": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"method\":\"getAllTasks\",\"id\":1,\"params\":{\"project_id\":1}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth"
      },
      "id": "get-tasks",
      "name": "Get Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpBasicAuth": {
          "id": "kanboard_auth",
          "name": "kanboard_auth"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "result"
      },
      "id": "split-tasks",
      "name": "Split Tasks",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.title }}",
              "operation": "contains",
              "value2": "Due Diligence"
            }
          ]
        }
      },
      "id": "filter-dd",
      "name": "Filter DD",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "task_id",
              "name": "task_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "company_name",
              "name": "company_name", 
              "value": "={{ $json.title }}",
              "type": "string"
            },
            {
              "id": "sections",
              "name": "sections",
              "value": "=[\"Executive Summary\",\"Company Overview\",\"Market Analysis\",\"Financial Analysis\"]",
              "type": "array"
            }
          ]
        }
      },
      "id": "prepare-data",
      "name": "Prepare Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "sections"
      },
      "id": "split-sections",
      "name": "Split Sections",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:11434/api/generate",
        "requestMethod": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "={\"model\":\"llama3.2\",\"prompt\":\"Generate a detailed \" + $json + \" section for company: \" + $('Prepare Data').item.json.company_name + \". Provide professional analysis in markdown format.\",\"stream\":false}"
      },
      "id": "ai-generate",
      "name": "AI Generate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/jsonrpc.php",
        "requestMethod": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "={\"jsonrpc\":\"2.0\",\"method\":\"createComment\",\"id\":1,\"params\":{\"task_id\":\"\" + $('Prepare Data').item.json.task_id + \"\",\"content\":\"## \" + $('Split Sections').item.json + \"\\n\\n\" + $json.response,\"user_id\":1}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth"
      },
      "id": "post-comment",
      "name": "Post Comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300],
      "credentials": {
        "httpBasicAuth": {
          "id": "kanboard_auth",
          "name": "kanboard_auth"
        }
      }
    }
  ],
