            "name": "Get Projects",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                680,
                300
            ],
            "credentials": {
                "httpBasicAuth": {
                    "name": "Kanboard Admin"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Input data\nconst config = $input.first().json.agentConfig;\nconst existingProjects = $input.last().json.result || [];\n\n// Create map of existing projects\nconst projectMap = new Map(\n  existingProjects.map(p => [p.name, p])\n);\n\n// Find projects to create\nconst projectsToCreate = [];\n\nObject.entries(config).forEach(([dept, info]) => {\n  if (!projectMap.has(info.projectName)) {\n    projectsToCreate.push({\n      name: info.projectName,\n      description: info.description\n    });\n  }\n});\n\nif (projectsToCreate.length === 0) {\n  return [{json: { message: 'No new projects needed' }}];\n}\n\nreturn projectsToCreate.map(project => ({json: project}));"
            },
            "name": "Process Projects",
            "type": "n8n-nodes-base.code",
            "typeVersion": 1,
