                "url": "http://localhost:8000/jsonrpc.php",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpBasicAuth",
                "method": "POST",
                "sendBody": true,
                "bodyParameters": {
                    "values": [
                        {
                            "name": "jsonrpc",
                            "value": "2.0"
                        },
                        {
