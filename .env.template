# Complete System Environment Configuration
# Copy this file to .env and fill in your actual values

# === REQUIRED VARIABLES ===

# OpenAI API Key (required for embeddings and AI fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Configuration (required for vector storage)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=your_pinecone_index_name_here

# MongoDB Configuration (required for data storage)
MONGODB_URI=mongodb://localhost:27017/genius_project

# Flask Security
SECRET_KEY=your_secret_key_here

# === OPTIONAL VARIABLES ===

# Local Llama Server (preferred AI service)
LLAMA_API_URL=http://localhost:8080

# Development/Testing
USE_MOCK_AI=false

# === SERVICE CONFIGURATION ===

# For production deployment
PORT=5000
FLASK_ENV=production

# For development
FLASK_DEBUG=true
