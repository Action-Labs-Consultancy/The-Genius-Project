    {
      "parameters": {
        "functionCode": "const company = $json.company_name;\nconst today = new Date().toISOString().split('T')[0];\nconst companyContent = $json.content || 'No content available';\nconst primaryWebsite = $json.primary_website || 'No website available';\nconst primaryEmail = $json.primary_email || 'No email available';\n\nconst prompt = `Generate Section 1 of a due diligence report for '${company}' as an expert financial analyst using the provided company information.\nThis section is titled: \"Introduction & Engagement Context\".\n\nCOMPANY INFORMATION:\n- Company: ${company}\n- Website: ${primaryWebsite}\n- Email: ${primaryEmail}\n- Content Extract: ${companyContent.substring(0, 500)}...\n\nSECTION STRUCTURE:\n# Due Diligence Report: ${company}\n## Section 1: Introduction & Engagement Context\n- Purpose of the due diligence engagement\n- Scope of the review (what areas are covered)\n- Context for why this due diligence is being performed\n- Relevance of the engagement to stakeholders\n- Timeframe and current date reference\n\nREQUIREMENTS:\n- Use the provided company information from PDFs\n- Be specific and factual (no placeholders)\n- Write at least 300 words\n- Make it professional and concise\n- Current date: ${today}`;\n\nconsole.log(`Prompt for ${company} - Section 1: ${prompt.substring(0, 200)}...`);\n\nreturn {\n  json: {\n    ...$json,\n    prompt,\n    task_id: Math.floor(Math.random() * 10000),\n    project_id: 1,\n    current_section: {\n      name: 'Introduction & Engagement Context',\n      id: 1\n    }\n  }\n};\n"
      },
