    {
      "parameters": {
        "functionCode": "const report = $input.first().json.response || '';\nconst inputData = $node['Create Prompt'].json;\n\nconsole.log(`Report received (Section 1): ${report.substring(0, 100)}...`);\n\n// Handle HTTP errors from the LLM\nif ($node['Generate Report'].error) {\n  console.error('Report generation error:', $node['Generate Report'].error.message);\n  return {\n    json: {\n      task_id: inputData.task_id,\n      description: `# ⚠️ Report Generation Failed - Section 1\\n\\n**Company:** ${inputData.company_name}\\n**Error:** ${$node['Generate Report'].error.message}\\n\\nPlease generate Section 1 manually.`\n    }\n  };\n}\n\n// Clean up unwanted placeholders from the report\nconst cleanReport = report\n  .replace(/\\{\\{[^}]*\\}\\}/g, 'information not available')\n  .replace(/\\$json\\.[\\w.]+/g, 'information not available');\n\nconsole.log(`Cleaned Section 1 report: ${cleanReport.substring(0, 100)}...`);\n\n// Return the processed Section 1 content\nreturn {\n  json: {\n    task_id: inputData.task_id,\n    project_id: inputData.project_id,\n    description: `# Due Diligence Report: ${inputData.company_name}\\n\\n## Section 1: Introduction & Engagement Context\\n\\n**Generated:** ${new Date().toISOString()}\\n\\n${cleanReport.substring(0, 1000)} [truncated for debugging]\\n\\n---\\n\\n_Automatically generated by n8n_`\n  }\n};\n"
      },
