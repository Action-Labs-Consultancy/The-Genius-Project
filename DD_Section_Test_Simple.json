    {
      "parameters": {
        "functionCode": "// Simple test for HTTP request to Ollama\nconst testPrompt = 'Generate a brief 100-word introduction for a due diligence report about Test Company.';\n\nconsole.log('🧪 Testing with simple prompt:');\nconsole.log(testPrompt);\n\nreturn {\n  json: {\n    company_name: 'Test Company',\n    maker_prompt: testPrompt,\n    test_mode: true\n  }\n};"
      },
      "name": "Create Test Prompt",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        0,
        400
      ],
      "id": "create-test-prompt"
    },
    {
      "parameters": {
        "url": "http://localhost:11434/api/generate",
        "options": {
          "bodyContentType": "json",
          "jsonBody": "={\n  \"model\": \"llama3\",\n  \"prompt\": \"{{ $json.maker_prompt }}\",\n  \"stream\": false,\n  \"options\": {\n    \"temperature\": 0.7,\n    \"max_tokens\": 200\n  }\n}",
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 60000
        }
      },
      "name": "Test LLM Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        400
      ],
      "id": "test-llm-call"
    },
    {
      "parameters": {
        "functionCode": "// Display test results\nconst response = $input.first().json;\n\nconsole.log('🎉 Test Response:');\nconsole.log('Model:', response.model);\nconsole.log('Response length:', response.response ? response.response.length : 0);\nconsole.log('First 200 chars:', response.response ? response.response.substring(0, 200) : 'No response');\n\nreturn {\n  json: {\n    test_successful: true,\n    response_preview: response.response ? response.response.substring(0, 200) : 'No response',\n    full_response: response.response || 'No response received'\n  }\n};"
      },
      "name": "Display Results",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
