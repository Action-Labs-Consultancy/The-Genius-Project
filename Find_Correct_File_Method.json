    {
      "parameters": {
        "functionCode": "// Check which method worked\nconst inputs = $input.all();\nconst taskInfo = inputs[0].json;\nconsole.log(`\\n=== TESTING FILE METHODS FOR TASK ${taskInfo.task_id} ===`);\n\nconst methods = [\n  { name: 'getAllFiles', response: inputs[1].json },\n  { name: 'getFiles', response: inputs[2].json },\n  { name: 'getTaskFiles', response: inputs[3].json }\n];\n\nlet workingMethod = null;\nlet filesFound = [];\n\nmethods.forEach(method => {\n  console.log(`\\n--- Testing ${method.name} ---`);\n  \n  if (method.response.error) {\n    console.log(`❌ Error: ${method.response.error.message}`);\n  } else {\n    console.log(`✅ Success!`);\n    \n    if (method.response.result && Array.isArray(method.response.result)) {\n      const files = method.response.result;\n      console.log(`Found ${files.length} files`);\n      \n      if (files.length > 0) {\n        workingMethod = method.name;\n        filesFound = files;\n        \n        files.forEach((file, index) => {\n          console.log(`  File ${index + 1}: ${file.name} (${file.size} bytes)`);\n          console.log(`    ID: ${file.id}, MIME: ${file.mimetype}`);\n          console.log(`    Token: ${file.token}`);\n        });\n      }\n    } else {\n      console.log(`Result: ${JSON.stringify(method.response.result)}`);\n    }\n  }\n});\n\nif (workingMethod) {\n  console.log(`\\n🎉 Working method found: ${workingMethod}`);\n  console.log(`Files discovered: ${filesFound.length}`);\n} else {\n  console.log(`\\n❌ No working file method found`);\n}\n\nreturn {\n  json: {\n    task_id: taskInfo.task_id,\n    working_method: workingMethod,\n    files_count: filesFound.length,\n    files: filesFound,\n    message: workingMethod ? `Use ${workingMethod} method` : 'No file method works'\n  }\n};"
      },
