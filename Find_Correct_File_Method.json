        "functionCode": "// Get task IDs to test file methods\nconst tasks = $input.first().json.result || [];\nconsole.log(`Found ${tasks.length} tasks`);\n\nif (tasks.length === 0) {\n  throw new Error('No tasks found to test');\n}\n\n// Return first task ID for testing\nconst firstTask = tasks[0];\nconsole.log(`Testing with task: ${firstTask.title} (ID: ${firstTask.id})`);\n\nreturn {\n  json: {\n    task_id: parseInt(firstTask.id),\n    title: firstTask.title\n  }\n};"
