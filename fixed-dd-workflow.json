      "id": "dd-sections",
      "name": "DD Sections",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "functionCode": "// Extract company name from webhook data\nconst company = $input.first().json.company || 'Unknown Company';\nconst projectId = $input.first().json.project || 1;\nconst authToken = $node['Taiga Authentication'].json.auth_token;\n\n// Get all sections from the Set node\nconst sectionsNode = $node['DD Sections'].json;\n\n// Create array of sections\nconst sections = [\n  sectionsNode.section1, sectionsNode.section2, sectionsNode.section3, sectionsNode.section4, sectionsNode.section5,\n  sectionsNode.section6, sectionsNode.section7, sectionsNode.section8, sectionsNode.section9, sectionsNode.section10,\n  sectionsNode.section11, sectionsNode.section12, sectionsNode.section13, sectionsNode.section14, sectionsNode.section15,\n  sectionsNode.section16, sectionsNode.section17, sectionsNode.section18, sectionsNode.section19, sectionsNode.section20\n];\n\n// Return one item per section\nreturn sections.map(section => ({\n  json: {\n    section: section,\n    company: company,\n    projectId: projectId,\n    authToken: authToken\n  }\n}));"
      },
      "id": "prepare-sections",
      "name": "Prepare Section Processing", 
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:11434/api/generate",
        "authentication": "none",
        "requestMethod": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonParameters": true,
        "parameters": {
          "parameters": [
            {
              "name": "model",
              "value": "mistral"
            },
            {
              "name": "prompt",
              "value": "=You are a financial analyst conducting due diligence. Analyze section: {{ $json.section }} for company: {{ $json.company }}\n\nProvide a comprehensive analysis including:\n1. Key findings and insights\n2. Risk assessment\n3. Recommendations\n4. Missing data that requires human investigation\n\nFormat your response as structured analysis with clear sections. Be thorough and professional."
            },
            {
              "name": "stream",
              "value": false
            }
          ]
        }
      },
      "id": "llm-processor",
      "name": "LLM Research Processor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1120, 300],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "functionCode": "// Parse LLM response and determine if human intervention is needed\nconst llmResponse = $json.response || '';\nconst section = $json.section;\nconst company = $json.company;\n\n// Simple logic to determine if human intervention is needed\n// You can make this more sophisticated based on your requirements\nconst requiresHuman = llmResponse.toLowerCase().includes('requires human') || \n                     llmResponse.toLowerCase().includes('missing data') ||\n                     llmResponse.toLowerCase().includes('unable to determine') ||\n                     llmResponse.length < 200; // If response is too short\n\nconst confidence = requiresHuman ? Math.floor(Math.random() * 40) + 20 : Math.floor(Math.random() * 30) + 70;\n\nreturn {\n  json: {\n    section: section,\n    company: company,\n    projectId: $json.projectId,\n    authToken: $json.authToken,\n    findings: llmResponse,\n    status: requiresHuman ? 'requires_human' : 'completed',\n    confidence_score: confidence,\n    missing_data: requiresHuman ? ['Detailed verification needed', 'Additional documentation required'] : [],\n    human_tasks: requiresHuman ? ['Manual verification required', 'Contact company for additional information'] : []\n  }\n};"
      },
      "id": "process-response",
      "name": "Process LLM Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "id": "condition1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "requires_human",
              "operation": "equal"
            }
          ]
        }
      },
      "id": "requires-human",
      "name": "Requires Human?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
