{
  "name": "AI Due Diligence - FINAL WORKING",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "cron-trigger-001",
      "name": "Every 2 Minutes",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/jsonrpc.php",
        "requestMethod": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"jsonrpc\":\"2.0\",\"method\":\"getAllTasks\",\"id\":1,\"params\":{\"project_id\":1}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth"
      },
      "id": "get-tasks-001",
      "name": "Get Kanboard Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpBasicAuth": {
          "id": "kanboard_auth",
          "name": "kanboard_auth"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "result"
      },
      "id": "split-tasks-001",
      "name": "Split Individual Tasks",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.title }}",
              "operation": "contains",
              "value2": "Due Diligence"
            }
          ]
        }
      },
      "id": "filter-dd-001",
      "name": "Check if Due Diligence",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "task_id",
              "name": "task_id",
              "value": "={{ $json.id }}",
              "type": "number"
            },
            {
              "id": "company_name",
              "name": "company_name", 
              "value": "={{ $json.title }}",
              "type": "string"
            },
            {
              "id": "dd_sections",
              "name": "dd_sections",
              "value": "=[\"Executive Summary\",\"Company Overview\",\"Market Analysis\",\"Financial Performance\",\"Risk Assessment\",\"Investment Recommendation\"]",
              "type": "array"
            }
          ]
        }
      },
      "id": "prepare-data-001",
      "name": "Setup Company Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "dd_sections"
      },
      "id": "split-sections-001",
      "name": "Process Each Section",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:11434/api/generate",
        "requestMethod": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "={\"model\":\"mistral:latest\",\"prompt\":\"Generate a comprehensive \" + $json + \" analysis for: \" + $('Setup Company Data').item.json.company_name + \". Provide detailed professional analysis with specific insights, recommendations, and key findings. Format in clean markdown with headers and bullet points. Minimum 200 words.\",\"stream\":false}"
      },
      "id": "ai-analysis-001",
      "name": "Generate AI Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/jsonrpc.php",
        "requestMethod": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "={\"jsonrpc\":\"2.0\",\"method\":\"createComment\",\"id\":1,\"params\":{\"task_id\":\" + $('Setup Company Data').item.json.task_id + \",\"content\":\"## 📊 \" + $('Process Each Section').item.json + \"\\n\\n\" + $json.response + \"\\n\\n---\\n*Generated by AI Due Diligence System*\",\"user_id\":1}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth"
      },
      "id": "post-analysis-001",
      "name": "Post to Kanboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 300],
      "credentials": {
        "httpBasicAuth": {
          "id": "kanboard_auth",
          "name": "kanboard_auth"
        }
      }
    }
  ],
