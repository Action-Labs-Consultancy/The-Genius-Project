    {
      "parameters": {
        "jsCode": "// Get the agent config from first input and existing projects from second input\nconst agentConfig = $input.first().json;\nconst existingProjects = $input.last().json.result || [];\n\n// Create map of existing projects by name\nconst existingProjectNames = new Set(existingProjects.map(p => p.name));\n\n// Process each department and find projects that need to be created\nconst projectsToCreate = [];\nconst usersToCreate = [];\n\nObject.entries(agentConfig).forEach(([deptName, deptInfo]) => {\n  // Check if project exists\n  if (!existingProjectNames.has(deptInfo.projectName)) {\n    projectsToCreate.push({\n      name: deptInfo.projectName,\n      description: deptInfo.description,\n      department: deptName\n    });\n  }\n  \n  // Add all agents from this department to users list\n  deptInfo.agents.forEach(agent => {\n    usersToCreate.push({\n      ...agent,\n      department: deptName,\n      projectName: deptInfo.projectName\n    });\n  });\n});\n\nreturn {\n  projectsToCreate,\n  usersToCreate,\n  totalProjects: projectsToCreate.length,\n  totalUsers: usersToCreate.length\n};"
      },
      "id": "c7d8e561-93c4-4f63-8bcd-9d9d7c0f841d",
