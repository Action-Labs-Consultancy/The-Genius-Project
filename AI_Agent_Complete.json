    {
      "parameters": {
        "jsCode": "const agentConfig = {\n  \"Strategy\": {\n    projectName: \"🎯 AI Strategy Department\",\n    description: \"Strategic planning and competitive analysis AI agents\",\n    agents: [\n      { name: \"Strategic Planner AI\", username: \"ai-strategy-planner\", email: \"ai-strategy-planner@company.local\", role: \"Strategic planning and roadmap development\" },\n      { name: \"Market Analyst AI\", username: \"ai-market-analyst\", email: \"ai-market-analyst@company.local\", role: \"Market research and trend analysis\" }\n    ]\n  },\n  \"Marketing\": {\n    projectName: \"📈 AI Marketing Department\",\n    description: \"Content creation and digital marketing AI agents\",\n    agents: [\n      { name: \"Content Creator AI\", username: \"ai-content-creator\", email: \"ai-content-creator@company.local\", role: \"Blog posts, articles, and copy creation\" },\n      { name: \"Social Media Manager AI\", username: \"ai-social-manager\", email: \"ai-social-manager@company.local\", role: \"Social media content and scheduling\" }\n    ]\n  },\n  \"Development\": {\n    projectName: \"💻 AI Development Department\",\n    description: \"Software development and testing AI agents\",\n    agents: [\n      { name: \"Code Review AI\", username: \"ai-code-reviewer\", email: \"ai-code-reviewer@company.local\", role: \"Code review and quality assurance\" },\n      { name: \"Testing AI\", username: \"ai-tester\", email: \"ai-tester@company.local\", role: \"Automated testing and bug detection\" }\n    ]\n  }\n};\n\nreturn agentConfig;"
      },
