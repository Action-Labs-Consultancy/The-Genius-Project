# Plane Environment Configuration
DEBUG=1
DJANGO_SETTINGS_MODULE=plane.settings.production

# Database
DATABASE_URL=postgresql://plane:plane@plane-db:5432/plane

# Redis
REDIS_URL=redis://plane-redis:6379/

# Application settings
SECRET_KEY=super-secret-key-change-in-production
WEB_URL=http://localhost:3001

# MinIO
USE_MINIO=1
MINIO_ENDPOINT=plane-minio:9000
MINIO_ACCESS_KEY=plane
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=plane

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# License
LICENSE_ENGINE_BASE_URL=https://control-center.plane.so
