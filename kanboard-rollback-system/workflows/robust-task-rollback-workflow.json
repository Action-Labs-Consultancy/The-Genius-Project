{
  "name": "🔄 Robust Task Rollback Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "webhook-trigger",
      "name": "Task Modification Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "task-modification-trigger"
    },
    {
      "parameters": {
        "url": "http://localhost:3001/api/snapshot/create",
        "requestMethod": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "taskId",
              "value": "={{ $json.taskId }}"
            },
            {
              "name": "reason",
              "value": "pre_ai_modification"
            },
            {
              "name": "userId",
              "value": "ai_system"
            }
          ]
        }
      },
      "id": "create-pre-snapshot",
      "name": "📸 Create Pre-Modification Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:3001/api/ai/confidence-check",
        "requestMethod": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "taskId",
              "value": "={{ $json.taskId }}"
            },
            {
              "name": "modifications",
              "value": "={{ $json.modifications }}"
            },
            {
              "name": "aiScore",
              "value": "={{ $json.aiScore || 0.85 }}"
            }
          ]
        }
      },
      "id": "ai-confidence-check",
      "name": "🤖 AI Confidence Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.confidence.requiresApproval }}",
              "operation": "equal",
              "value2": "true"
            }
          ]
        }
      },
      "id": "requires-approval-check",
      "name": "⚠️ Requires Approval?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/jsonrpc.php",
        "requestMethod": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "jsonrpc",
              "value": "2.0"
            },
            {
              "name": "method",
              "value": "updateTask"
            },
            {
              "name": "id",
              "value": "={{ Date.now() }}"
            },
            {
              "name": "params",
              "value": "={{ $json.taskUpdates }}"
            }
          ]
        },
        "authentication": "genericCredential",
        "genericAuthType": "httpBasicAuth"
      },
      "id": "execute-modifications",
      "name": "✅ Execute Task Modifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "status",
              "value": "approval_required"
            },
            {
              "name": "taskId",
              "value": "={{ $json.taskId }}"
            },
            {
              "name": "message",
              "value": "Task modification requires manual approval due to low AI confidence"
            }
          ]
        }
      },
      "id": "approval-required",
      "name": "⏸️ Manual Approval Required",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "url": "http://localhost:3001/api/snapshot/create",
        "requestMethod": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "taskId",
              "value": "={{ $json.taskId }}"
            },
            {
              "name": "reason",
              "value": "post_ai_modification"
            },
            {
              "name": "userId",
              "value": "ai_system"
            }
          ]
        }
      },
      "id": "create-post-snapshot",
      "name": "📸 Create Post-Modification Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "status",
              "value": "completed"
            },
            {
              "name": "taskId",
              "value": "={{ $json.taskId }}"
            },
            {
              "name": "preSnapshotId",
              "value": "={{ $node['📸 Create Pre-Modification Snapshot'].json.versionId }}"
            },
            {
              "name": "postSnapshotId",
              "value": "={{ $json.versionId }}"
            },
            {
              "name": "message",
              "value": "Task modification completed with full rollback capability"
            }
          ]
        }
      },
      "id": "workflow-complete",
      "name": "✅ Workflow Complete",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1560, 200]
    }
  ],
  "connections": {
    "Task Modification Webhook": {
      "main": [
        [
          {
            "node": "📸 Create Pre-Modification Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "📸 Create Pre-Modification Snapshot": {
      "main": [
        [
          {
            "node": "🤖 AI Confidence Check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🤖 AI Confidence Check": {
      "main": [
        [
          {
            "node": "⚠️ Requires Approval?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "⚠️ Requires Approval?": {
      "main": [
        [
          {
            "node": "✅ Execute Task Modifications",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "⏸️ Manual Approval Required",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "✅ Execute Task Modifications": {
      "main": [
        [
          {
            "node": "📸 Create Post-Modification Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "📸 Create Post-Modification Snapshot": {
      "main": [
        [
          {
            "node": "✅ Workflow Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "createdAt": "2025-01-14T00:00:00.000Z",
  "updatedAt": "2025-01-14T00:00:00.000Z",
  "id": "robust-rollback-workflow",
  "tags": ["rollback", "ai", "kanboard"]
}
