# Taiga Configuration File
# This file contains environment variables for customizing your Taiga installation

# ===== DATABASE SETTINGS =====
POSTGRES_DB=taiga
POSTGRES_USER=taiga
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=taiga-db

# ===== TAIGA BACKEND SETTINGS =====
TAIGA_SECRET_KEY=your_secret_key_here_change_this_in_production
TAIGA_SITES_SCHEME=http
TAIGA_SITES_DOMAIN=localhost:9000
TAIGA_SUBPATH=""

# ===== FRONTEND SETTINGS =====
TAIGA_URL=http://localhost:9000
TAIGA_WEBSOCKETS_URL=ws://localhost:8888
API=http://localhost:8000/api/v1/
EVENTS_URL=ws://localhost:8888/events

# ===== FEATURE FLAGS =====
PUBLIC_REGISTER_ENABLED=true
DEBUG=true
ENABLE_TELEMETRY=false

# ===== EMAIL SETTINGS (Optional) =====
EMAIL_BACKEND=console
DEFAULT_FROM_EMAIL=no-reply@localhost
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""

# ===== REDIS SETTINGS =====
CELERY_BROKER_URL=redis://taiga-redis:6379/0

# ===== RABBITMQ SETTINGS =====
RABBITMQ_USER=taiga
RABBITMQ_PASS=taiga
RABBITMQ_HOST=taiga-events-rabbitmq
RABBITMQ_VHOST=taiga
RABBITMQ_PORT=5672

# ===== GITHUB INTEGRATION (Optional) =====
GITHUB_IMPORTER_CLIENT_ID=""
GITHUB_IMPORTER_CLIENT_SECRET=""

# ===== LDAP SETTINGS (Optional) =====
LDAP_SERVER=""
LDAP_PORT=389
LDAP_BIND_DN=""
LDAP_BIND_PASSWORD=""
LDAP_SEARCH_BASE=""
LDAP_SEARCH_PROPERTY=""
LDAP_SEARCH_SUFFIX=""
LDAP_EMAIL_PROPERTY=""
LDAP_FULL_NAME_PROPERTY=""

# ===== SOCIAL AUTH (Optional) =====
SOCIAL_AUTH_GITHUB_KEY=""
SOCIAL_AUTH_GITHUB_SECRET=""
SOCIAL_AUTH_TWITTER_KEY=""
SOCIAL_AUTH_TWITTER_SECRET=""
SOCIAL_AUTH_FACEBOOK_KEY=""
SOCIAL_AUTH_FACEBOOK_SECRET=""
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=""
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=""

# ===== CUSTOMIZATION =====
DEFAULT_LANGUAGE=en
DEFAULT_THEME=material-design
COMPANY_NAME="Your Company"
SUPPORT_URL=""
PRIVACY_POLICY_URL=""
TERMS_OF_SERVICE_URL=""

# ===== PERFORMANCE SETTINGS =====
MAX_AGE=360
FRONTEND_DEBUG=true

# ===== SECURITY SETTINGS =====
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=true

# ===== FILE UPLOAD SETTINGS =====
MAX_UPLOAD_FILE_SIZE=100MB
FILE_UPLOAD_PERMISSIONS=0o644

# ===== BACKUP SETTINGS =====
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
