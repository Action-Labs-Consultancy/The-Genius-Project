# Social Media OAuth Configuration
# Copy this file to .env and fill in your actual credentials

# Facebook/Instagram OAuth
FACEBOOK_CLIENT_ID=your_facebook_app_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret_here
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/social/callback/facebook

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/social/callback/linkedin

# Twitter OAuth (if implementing Twitter in the future)
TWITTER_CLIENT_ID=your_twitter_client_id_here
TWITTER_CLIENT_SECRET=your_twitter_client_secret_here
TWITTER_REDIRECT_URI=http://localhost:5000/api/social/callback/twitter

# Security
OAUTH_STATE_SECRET=your_secure_random_string_for_state_validation
TOKEN_ENCRYPTION_KEY=your_32_character_encryption_key_here

# Production URLs (update for production deployment)
# FACEBOOK_REDIRECT_URI=https://yourdomain.com/api/social/callback/facebook
# LINKEDIN_REDIRECT_URI=https://yourdomain.com/api/social/callback/linkedin
# TWITTER_REDIRECT_URI=https://yourdomain.com/api/social/callback/twitter

# MongoDB Connection (if different from main app)
# MONGODB_URI=mongodb://localhost:27017/genius_project
