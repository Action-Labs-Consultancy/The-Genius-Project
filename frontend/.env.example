# API Configuration for The Genius Project
# Set this to your backend server URL

# For local development on same machine
# REACT_APP_API_BASE_URL=http://localhost:10000

# For LAN access (replace with your machine's IP)
REACT_APP_API_BASE_URL=http://192.168.100.63:10000

# For production
# REACT_APP_API_BASE_URL=https://your-backend-domain.com
