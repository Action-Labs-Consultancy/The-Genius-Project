/* Marketing AI Tasks Lab Page Styles - Enhanced Black & Yellow Theme */

.marketing-lab-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0f0f0f 100%);
  color: #ffffff;
  padding: 24px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
}

.lab-header {
  background: linear-gradient(135deg, rgba(255, 214, 0, 0.05) 0%, rgba(255, 214, 0, 0.02) 100%);
  border: 1px solid rgba(255, 214, 0, 0.2);
  border-radius: 20px;
  padding: 32px;
  margin-bottom: 32px;
  box-shadow: 
    0 8px 32px rgba(255, 214, 0, 0.1),
    inset 0 1px 0 rgba(255, 214, 0, 0.1);
  backdrop-filter: blur(20px);
  position: relative;
  overflow: hidden;
}

.lab-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, #FFD600, #FFC107, #FFB300);
  border-radius: 20px 20px 0 0;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
}

.header-title {
  display: flex;
  align-items: center;
  gap: 20px;
}

.header-icon {
  color: #FFD600;
  background: rgba(255, 214, 0, 0.15);
  padding: 12px;
  border-radius: 16px;
  border: 1px solid rgba(255, 214, 0, 0.3);
  filter: drop-shadow(0 4px 8px rgba(255, 214, 0, 0.2));
}

.header-title h1 {
  margin: 0;
  font-size: 32px;
  font-weight: 800;
  color: #FFD600;
  text-shadow: 0 2px 4px rgba(255, 214, 0, 0.3);
  letter-spacing: -0.5px;
  background: linear-gradient(135deg, #FFD600, #FFC107);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.header-title p {
  margin: 8px 0 0 0;
  color: #cccccc;
  font-size: 16px;
  font-weight: 500;
  opacity: 0.9;
}

.debug-toggle {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 24px;
  border: 2px solid #FFD600;
  border-radius: 14px;
  background: rgba(255, 214, 0, 0.1);
  color: #FFD600;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-size: 14px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  box-shadow: 0 4px 16px rgba(255, 214, 0, 0.2);
}

.debug-toggle:hover {
  border-color: #FFD600;
  color: #111;
  background: #FFD600;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(255, 214, 0, 0.3);
}

.lab-content {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  max-width: 1400px;
  margin: 0 auto;
}

.lab-content.with-sidebar {
  grid-template-columns: 1fr 380px;
}

.main-content {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

/* Task Input Section */
.task-input-section {
  background: linear-gradient(135deg, rgba(255, 214, 0, 0.03) 0%, rgba(255, 214, 0, 0.01) 100%);
  border: 1px solid rgba(255, 214, 0, 0.15);
  border-radius: 20px;
  padding: 40px;
  box-shadow: 
    0 12px 40px rgba(255, 214, 0, 0.08),
    inset 0 1px 0 rgba(255, 214, 0, 0.1);
  backdrop-filter: blur(20px);
  position: relative;
  overflow: hidden;
}

.task-input-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, #FFD600, #FFC107);
  border-radius: 20px 20px 0 0;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 32px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(255, 214, 0, 0.1);
}

.section-header svg {
  color: #FFD600;
  background: rgba(255, 214, 0, 0.1);
  padding: 10px;
  border-radius: 12px;
  border: 1px solid rgba(255, 214, 0, 0.2);
}

.section-header h2 {
  margin: 0;
  font-size: 24px;
  font-weight: 700;
  color: #FFD600;
  letter-spacing: -0.3px;
}

.section-header p {
  margin: 4px 0 0 0;
  color: #cccccc;
  font-size: 15px;
  opacity: 0.9;
}

/* Form Styling */
.task-form {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.form-label {
  font-weight: 600;
  color: #FFD600;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.form-input,
.form-textarea,
.form-select {
  padding: 14px 18px;
  border: 2px solid rgba(255, 214, 0, 0.2);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.02);
  color: #ffffff;
  font-size: 15px;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  backdrop-filter: blur(10px);
}

.form-input:focus,
.form-textarea:focus,
.form-select:focus {
  outline: none;
  border-color: #FFD600;
  background: rgba(255, 214, 0, 0.05);
  box-shadow: 0 0 0 3px rgba(255, 214, 0, 0.1);
}

.form-textarea {
  resize: vertical;
  min-height: 100px;
}

.execute-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 16px 32px;
  border: 2px solid #FFD600;
  border-radius: 14px;
  background: linear-gradient(135deg, #FFD600, #FFC107);
  color: #111;
  font-weight: 700;
  font-size: 16px;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: 0 4px 16px rgba(255, 214, 0, 0.3);
}

.execute-btn:hover:not(:disabled) {
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(255, 214, 0, 0.4);
}

.execute-btn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
  transform: none;
}
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 16px 32px;
  background: linear-gradient(135deg, #FFD600 0%, #FFA500 100%);
  color: #111;
  border: none;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-top: 8px;
}

.execute-btn:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(255, 214, 0, 0.3);
}

.execute-btn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.spinning {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Execution Panel */
.execution-panel {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 214, 0, 0.1);
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 8px 32px rgba(255, 214, 0, 0.1);
  backdrop-filter: blur(10px);
}

.agents-progress {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 32px;
}

.agent-card {
  background: rgba(255, 255, 255, 0.05);
  border: 2px solid rgba(255, 214, 0, 0.2);
  border-radius: 12px;
  padding: 20px;
  transition: all 0.3s ease;
}

.agent-card.completed {
  border-color: #48bb78;
  background: rgba(72, 187, 120, 0.1);
}

.agent-card.started {
  border-color: #FFD600;
  background: rgba(255, 214, 0, 0.1);
  animation: pulse 2s infinite;
}

.agent-card.error {
  border-color: #f56565;
  background: rgba(245, 101, 101, 0.1);
}

.agent-card.pending {
  border-color: rgba(255, 214, 0, 0.3);
  background: rgba(255, 214, 0, 0.05);
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.agent-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
}

.agent-info {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.status-icon {
  margin-top: 2px;
}

.status-icon.success { color: #48bb78; }
.status-icon.error { color: #f56565; }
.status-icon.running { color: #FFD600; }
.status-icon.pending { color: rgba(255, 214, 0, 0.5); }

.agent-info h3 {
  margin: 0;
  font-size: 18px;
  font-weight: 600;
  color: #ffffff;
}

.agent-info p {
  margin: 4px 0 0 0;
  color: #cccccc;
  font-size: 14px;
}

.expand-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  border: 1px solid rgba(255, 214, 0, 0.3);
  border-radius: 8px;
  background: rgba(255, 214, 0, 0.1);
  color: #FFD600;
  font-size: 12px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.expand-btn:hover {
  border-color: #FFD600;
  background: rgba(255, 214, 0, 0.2);
  color: #FFD600;
}

.agent-output {
  max-height: 60px;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.agent-output.expanded {
  max-height: 500px;
}

.output-text {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 214, 0, 0.2);
  border-radius: 8px;
  padding: 16px;
  font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;
  font-size: 13px;
  line-height: 1.5;
  color: #ffffff;
  white-space: pre-wrap;
  word-wrap: break-word;
  margin: 0;
}

.agent-error {
  background: rgba(245, 101, 101, 0.1);
  border: 1px solid #fed7d7;
  border-radius: 8px;
  padding: 12px;
  color: #c53030;
  font-size: 14px;
}

/* Final Output Card */
.final-output-card {
  background: linear-gradient(135deg, #FFD600 0%, #FFA500 100%);
  border-radius: 16px;
  padding: 32px;
  color: #111;
  box-shadow: 0 12px 24px rgba(255, 214, 0, 0.3);
}

.final-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
}

.final-header svg {
  background: rgba(0, 0, 0, 0.2);
  padding: 8px;
  border-radius: 12px;
}

.final-header h2 {
  margin: 0;
  font-size: 24px;
  font-weight: 600;
}

.final-header p {
  margin: 4px 0 0 0;
  opacity: 0.9;
  font-size: 14px;
}

.final-content {
  background: rgba(0, 0, 0, 0.1);
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 24px;
  backdrop-filter: blur(10px);
}

.final-text {
  font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;
  font-size: 14px;
  line-height: 1.6;
  color: #111;
  white-space: pre-wrap;
  word-wrap: break-word;
  margin: 0;
}

/* Performance Optimization Box */
.performance-optimization {
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 214, 0, 0.3);
  border-radius: 12px;
  padding: 20px;
  margin: 20px 0;
  backdrop-filter: blur(5px);
}

.performance-title {
  color: #FFD600;
  font-size: 14px;
  font-weight: 600;
  margin: 0 0 12px 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.performance-content {
  color: #111;
  font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;
  font-size: 13px;
  line-height: 1.5;
  margin: 0;
}

.performance-content ul {
  margin: 0;
  padding-left: 16px;
}

.performance-content li {
  margin: 4px 0;
}

.final-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 20px;
  border: 2px solid rgba(0, 0, 0, 0.3);
  border-radius: 12px;
  color: #111;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
  background: rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10px);
}

.action-btn:hover:not(:disabled) {
  background: rgba(0, 0, 0, 0.2);
  border-color: rgba(0, 0, 0, 0.5);
  transform: translateY(-1px);
}

.action-btn.primary {
  background: rgba(0, 0, 0, 0.2);
  border-color: rgba(0, 0, 0, 0.5);
}

.action-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Debug Sidebar */
.debug-sidebar {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 214, 0, 0.1);
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 8px 32px rgba(255, 214, 0, 0.1);
  backdrop-filter: blur(10px);
  max-height: calc(100vh - 140px);
  overflow-y: auto;
}

.debug-section {
  margin-bottom: 24px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(255, 214, 0, 0.2);
}

.debug-section:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.debug-section h3 {
  margin: 0 0 16px 0;
  font-size: 16px;
  font-weight: 600;
  color: #FFD600;
}

.debug-info p {
  margin: 8px 0;
  font-size: 14px;
  color: #cccccc;
}

.agents-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.agent-debug-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 214, 0, 0.2);
  border-radius: 8px;
  padding: 16px;
}

.agent-debug-card h4 {
  margin: 0 0 8px 0;
  font-size: 14px;
  font-weight: 600;
  color: #ffffff;
}

.agent-role {
  margin: 0 0 12px 0;
  font-size: 12px;
  color: #cccccc;
}

.agent-prompt {
  font-size: 12px;
}

.agent-prompt summary {
  cursor: pointer;
  font-weight: 500;
  color: #FFD600;
  margin-bottom: 8px;
}

.agent-prompt p {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 214, 0, 0.2);
  border-radius: 6px;
  padding: 12px;
  font-size: 11px;
  line-height: 1.4;
  color: #cccccc;
  margin: 8px 0 0 0;
}

.recent-executions {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.execution-summary {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 214, 0, 0.2);
  border-radius: 8px;
  padding: 12px;
  position: relative;
}

.execution-summary p {
  margin: 0 0 4px 0;
  font-size: 13px;
  color: #ffffff;
}

.exec-date {
  font-size: 11px !important;
  color: #cccccc !important;
}

.exec-status {
  position: absolute;
  top: 8px;
  right: 8px;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 10px;
  font-weight: 500;
  text-transform: uppercase;
}

.exec-status.completed {
  background: rgba(72, 187, 120, 0.1);
  color: #38a169;
}

.exec-status.error {
  background: rgba(245, 101, 101, 0.1);
  color: #e53e3e;
}

.exec-status.running {
  background: rgba(255, 214, 0, 0.1);
  color: #FFD600;
}

/* Responsive Design */
@media (max-width: 1200px) {
  .lab-content.with-sidebar {
    grid-template-columns: 1fr;
  }
  
  .debug-sidebar {
    order: -1;
    max-height: 300px;
  }
}

@media (max-width: 768px) {
  .marketing-lab-page {
    padding: 12px;
  }
  
  .lab-header {
    padding: 20px;
  }
  
  .header-content {
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }
  
  .task-input-section,
  .execution-panel {
    padding: 24px;
  }
  
  .form-row {
    grid-template-columns: 1fr;
  }
  
  .final-actions {
    flex-direction: column;
  }
  
  .action-btn {
    justify-content: center;
  }
}
