      "parameters": {
        "functionCode": "// Analyze all API responses to find the working method\nconst inputs = $input.all();\n\nconsole.log('=== KANBOARD API METHOD TESTING ===');\n\ninputs.forEach((input, index) => {\n  const response = input.json;\n  const methodNames = ['getAllFiles', 'getFiles', 'getAllTaskFiles', 'getTask'];\n  \n  console.log(`\\n--- ${methodNames[index]} ---`);\n  \n  if (response.error) {\n    console.log(`❌ Error: ${response.error.message} (Code: ${response.error.code})`);\n  } else if (response.result) {\n    console.log(`✅ Success!`);\n    console.log(`Result type: ${typeof response.result}`);\n    \n    if (Array.isArray(response.result)) {\n      console.log(`Array length: ${response.result.length}`);\n      if (response.result.length > 0) {\n        console.log(`First item keys: ${Object.keys(response.result[0])}`);\n      }\n    } else if (typeof response.result === 'object') {\n      console.log(`Object keys: ${Object.keys(response.result)}`);\n      \n      // Check if it has file-related properties\n      const keys = Object.keys(response.result);\n      const fileKeys = keys.filter(key => \n        key.toLowerCase().includes('file') || \n        key.toLowerCase().includes('attachment')\n      );\n      if (fileKeys.length > 0) {\n        console.log(`File-related keys: ${fileKeys}`);\n      }\n    }\n    \n    console.log(`Full response:`);\n    console.log(JSON.stringify(response.result, null, 2));\n  }\n});\n\nreturn {\n  json: {\n    message: 'API method testing completed - check console for results'\n  }\n};"
      },
